{
  "name": "tech-week-reservation",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11"
  },
  "scripts": {
    "prepare": "sh scripts/install-hooks.sh",
    "hooks:install": "sh scripts/install-hooks.sh",
    "test:hooks": "sh scripts/test-hooks.sh",
    "test:precommit": "npm run test:hooks && npm run typecheck && npm run format:check && npm test && npm run test:timing",
    "dev": "concurrently --kill-others --names frontend,backend \"npm run dev -w @tech-week/frontend\" \"npm run dev -w @tech-week/backend\"",
    "build": "npm run build --workspaces",
    "lint": "npm run lint --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run typecheck && npm run format:check",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f",
    "db:migrate": "npm run db:migrate -w @tech-week/backend",
    "admin:create": "npm run admin:create -w @tech-week/backend",
    "test": "npm test -w @tech-week/backend",
    "test:integration": "npm run test:integration -w @tech-week/backend",
    "test:services:up": "docker compose -f compose.test.yaml up -d --wait",
    "test:services:down": "docker compose -f compose.test.yaml down",
    "test:unit": "npm run test:unit -w @tech-week/backend",
    "test:modular": "npm run test:modular -w @tech-week/backend",
    "test:regression": "npm run test:regression -w @tech-week/backend",
    "test:e2e": "playwright test",
    "test:all": "npm test && npm run test:timing && npm run test:integration && npm run test:e2e",
    "test:security": "npm run test:security -w @tech-week/backend",
    "test:timing": "npm run test:timing -w @tech-week/backend"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.64.0",
    "@types/node": "^24.0.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.5.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.46.0"
  }
}
